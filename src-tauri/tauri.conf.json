{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../dist",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Game Accelerator",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.gameaccelerator.app",
      "icon": [
        "icons/icon.png",
        "icons/icon.ico",
        "icons/32x32.png",
        "icons/128x128.png"
      ],
      "resources": ["resources/**/*.dll"],
      "targets": ["msi", "nsis"]
    },
    "windows": [
      {
        "title": "Game Accelerator",
        "width": 900,
        "height": 620,
        "resizable": true
      }
    ]
  }
}