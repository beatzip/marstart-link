{
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "package": {
    "productName": "GameAccelerator",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      },
      "fs": {
        "all": false,
        "scope": ["$APPDATA/GameAccelerator/**", "$RESOURCE/**"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.gameaccelerator.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "resources/wireguard.dll",
        "resources/wintun.dll"
      ],
      "windows": {
        "webviewInstallMode": {
          "type": "embedBootstrapper"
        },
        "nsis": {
          "installer_name": "GameAccelerator_${version}_x64-setup.exe"
        },
        "wix": {
          "installer_name": "GameAccelerator_${version}_x64_en-US.msi"
        }
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ; img-src 'self' data: asset: https://asset.localhost ; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Game Accelerator",
        "width": 800,
        "height": 600
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/beatzip/sd-wan-gaming-client/releases/latest/download/latest.json"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQzRCQzU3RjkyRDUzRDIKUldUU1V5MzVWN3pFSUN1cnk2K2lPRm9nYUJNNit2TFB3N1VpSzlPNDhMa0hKS3lRaE1jb2NEc3gK"
    }
  }
}